#!/bin/sh
set -e

zero_sha="0000000000000000000000000000000000000000"
pushing_master=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ] && [ "$local_sha" != "$zero_sha" ]; then
    pushing_master=1
  fi
done

if [ "$pushing_master" -eq 0 ]; then
  exit 0
fi

echo "[pre-push] Pushing to master — running CI verification gate (npm run verify:ci)..."
npm run verify:ci
